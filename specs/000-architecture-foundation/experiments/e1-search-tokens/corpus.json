{
 "th": [
  "\u0e10\u0e32\u0e19\u0e04\u0e27\u0e32\u0e21\u0e23\u0e39\u0e49\u0e02\u0e2d\u0e07\u0e17\u0e35\u0e21\u0e0a\u0e48\u0e27\u0e22\u0e43\u0e2b\u0e49\u0e2a\u0e21\u0e32\u0e0a\u0e34\u0e01\u0e43\u0e2b\u0e21\u0e48\u0e40\u0e23\u0e35\u0e22\u0e19\u0e23\u0e39\u0e49\u0e44\u0e14\u0e49\u0e40\u0e23\u0e47\u0e27\u0e02\u0e36\u0e49\u0e19 \u0e40\u0e2d\u0e01\u0e2a\u0e32\u0e23\u0e17\u0e38\u0e01\u0e09\u0e1a\u0e31\u0e1a\u0e15\u0e49\u0e2d\u0e07\u0e21\u0e35\u0e41\u0e2b\u0e25\u0e48\u0e07\u0e17\u0e35\u0e48\u0e21\u0e32",
  "\u0e01\u0e32\u0e23\u0e04\u0e49\u0e19\u0e2b\u0e32\u0e20\u0e32\u0e29\u0e32\u0e44\u0e17\u0e22\u0e15\u0e49\u0e2d\u0e07\u0e15\u0e31\u0e14\u0e04\u0e33\u0e43\u0e2b\u0e49\u0e16\u0e39\u0e01\u0e15\u0e49\u0e2d\u0e07 \u0e40\u0e1e\u0e23\u0e32\u0e30\u0e20\u0e32\u0e29\u0e32\u0e44\u0e17\u0e22\u0e44\u0e21\u0e48\u0e21\u0e35\u0e0a\u0e48\u0e2d\u0e07\u0e27\u0e48\u0e32\u0e07\u0e23\u0e30\u0e2b\u0e27\u0e48\u0e32\u0e07\u0e04\u0e33",
  "\u0e23\u0e2b\u0e31\u0e2a\u0e1c\u0e48\u0e32\u0e19\u0e41\u0e25\u0e30\u0e01\u0e38\u0e0d\u0e41\u0e08\u0e25\u0e31\u0e1a\u0e2b\u0e49\u0e32\u0e21\u0e40\u0e01\u0e47\u0e1a\u0e44\u0e27\u0e49\u0e43\u0e19\u0e2b\u0e19\u0e49\u0e32\u0e27\u0e34\u0e01\u0e34 \u0e43\u0e2b\u0e49\u0e43\u0e0a\u0e49\u0e15\u0e31\u0e27\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23\u0e04\u0e27\u0e32\u0e21\u0e25\u0e31\u0e1a\u0e02\u0e2d\u0e07\u0e17\u0e35\u0e21",
  "\u0e02\u0e31\u0e49\u0e19\u0e15\u0e2d\u0e19\u0e01\u0e32\u0e23\u0e15\u0e34\u0e14\u0e15\u0e31\u0e49\u0e07\u0e42\u0e1b\u0e23\u0e41\u0e01\u0e23\u0e21\u0e1a\u0e19\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e27\u0e34\u0e19\u0e42\u0e14\u0e27\u0e2a\u0e4c\u0e15\u0e49\u0e2d\u0e07\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e40\u0e27\u0e2d\u0e23\u0e4c\u0e0a\u0e31\u0e19\u0e01\u0e48\u0e2d\u0e19\u0e40\u0e2a\u0e21\u0e2d",
  "\u0e01\u0e32\u0e23\u0e1b\u0e23\u0e30\u0e0a\u0e38\u0e21\u0e17\u0e35\u0e21\u0e17\u0e38\u0e01\u0e2a\u0e31\u0e1b\u0e14\u0e32\u0e2b\u0e4c\u0e2a\u0e23\u0e38\u0e1b\u0e04\u0e27\u0e32\u0e21\u0e04\u0e37\u0e1a\u0e2b\u0e19\u0e49\u0e32\u0e02\u0e2d\u0e07\u0e42\u0e04\u0e23\u0e07\u0e01\u0e32\u0e23\u0e41\u0e25\u0e30\u0e1b\u0e31\u0e0d\u0e2b\u0e32\u0e17\u0e35\u0e48\u0e1e\u0e1a",
  "\u0e41\u0e19\u0e27\u0e17\u0e32\u0e07\u0e01\u0e32\u0e23\u0e23\u0e35\u0e27\u0e34\u0e27\u0e42\u0e04\u0e49\u0e14\u0e01\u0e33\u0e2b\u0e19\u0e14\u0e43\u0e2b\u0e49\u0e1c\u0e39\u0e49\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e2a\u0e2d\u0e07\u0e04\u0e19\u0e2d\u0e19\u0e38\u0e21\u0e31\u0e15\u0e34\u0e01\u0e48\u0e2d\u0e19\u0e23\u0e27\u0e21\u0e07\u0e32\u0e19",
  "\u0e23\u0e30\u0e1a\u0e1a\u0e2a\u0e33\u0e23\u0e2d\u0e07\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e17\u0e33\u0e07\u0e32\u0e19\u0e17\u0e38\u0e01\u0e04\u0e37\u0e19\u0e41\u0e25\u0e30\u0e40\u0e01\u0e47\u0e1a\u0e2a\u0e33\u0e40\u0e19\u0e32\u0e44\u0e27\u0e49\u0e40\u0e08\u0e47\u0e14\u0e27\u0e31\u0e19",
  "\u0e04\u0e39\u0e48\u0e21\u0e37\u0e2d\u0e1c\u0e39\u0e49\u0e43\u0e0a\u0e49\u0e2d\u0e18\u0e34\u0e1a\u0e32\u0e22\u0e27\u0e34\u0e18\u0e35\u0e40\u0e02\u0e49\u0e32\u0e23\u0e48\u0e27\u0e21\u0e27\u0e34\u0e01\u0e34\u0e02\u0e2d\u0e07\u0e17\u0e35\u0e21\u0e14\u0e49\u0e27\u0e22\u0e25\u0e34\u0e07\u0e01\u0e4c\u0e17\u0e35\u0e48\u0e2d\u0e22\u0e39\u0e48\u0e02\u0e2d\u0e07\u0e17\u0e35\u0e48\u0e40\u0e01\u0e47\u0e1a",
  "\u0e01\u0e32\u0e23\u0e41\u0e01\u0e49\u0e1b\u0e31\u0e0d\u0e2b\u0e32\u0e40\u0e04\u0e23\u0e37\u0e2d\u0e02\u0e48\u0e32\u0e22\u0e02\u0e31\u0e14\u0e02\u0e49\u0e2d\u0e07\u0e40\u0e23\u0e34\u0e48\u0e21\u0e08\u0e32\u0e01\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e2a\u0e32\u0e22\u0e41\u0e25\u0e30\u0e15\u0e31\u0e27\u0e01\u0e23\u0e30\u0e08\u0e32\u0e22\u0e2a\u0e31\u0e0d\u0e0d\u0e32\u0e13",
  "\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01\u0e01\u0e32\u0e23\u0e15\u0e31\u0e14\u0e2a\u0e34\u0e19\u0e43\u0e08\u0e40\u0e0a\u0e34\u0e07\u0e2a\u0e16\u0e32\u0e1b\u0e31\u0e15\u0e22\u0e01\u0e23\u0e23\u0e21\u0e0a\u0e48\u0e27\u0e22\u0e43\u0e2b\u0e49\u0e17\u0e35\u0e21\u0e40\u0e02\u0e49\u0e32\u0e43\u0e08\u0e40\u0e2b\u0e15\u0e38\u0e1c\u0e25\u0e43\u0e19\u0e2d\u0e14\u0e35\u0e15",
  "\u0e01\u0e32\u0e23\u0e1d\u0e36\u0e01\u0e2d\u0e1a\u0e23\u0e21\u0e1e\u0e19\u0e31\u0e01\u0e07\u0e32\u0e19\u0e43\u0e2b\u0e21\u0e48\u0e43\u0e0a\u0e49\u0e40\u0e27\u0e25\u0e32\u0e2a\u0e2d\u0e07\u0e2a\u0e31\u0e1b\u0e14\u0e32\u0e2b\u0e4c\u0e41\u0e25\u0e30\u0e21\u0e35\u0e41\u0e1a\u0e1a\u0e17\u0e14\u0e2a\u0e2d\u0e1a\u0e17\u0e49\u0e32\u0e22\u0e2b\u0e25\u0e31\u0e01\u0e2a\u0e39\u0e15\u0e23",
  "\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32\u0e15\u0e49\u0e2d\u0e07\u0e44\u0e14\u0e49\u0e23\u0e31\u0e1a\u0e01\u0e32\u0e23\u0e1b\u0e01\u0e1b\u0e49\u0e2d\u0e07\u0e15\u0e32\u0e21\u0e19\u0e42\u0e22\u0e1a\u0e32\u0e22\u0e04\u0e27\u0e32\u0e21\u0e40\u0e1b\u0e47\u0e19\u0e2a\u0e48\u0e27\u0e19\u0e15\u0e31\u0e27\u0e02\u0e2d\u0e07\u0e2d\u0e07\u0e04\u0e4c\u0e01\u0e23"
 ],
 "zh": [
  "\u56e2\u961f\u77e5\u8bc6\u5e93\u5e2e\u52a9\u65b0\u6210\u5458\u5feb\u901f\u4e86\u89e3\u9879\u76ee\u80cc\u666f\u3002\u6bcf\u4efd\u6587\u6863\u90fd\u5fc5\u987b\u6ce8\u660e\u6765\u6e90\u3002",
  "\u4e2d\u6587\u641c\u7d22\u9700\u8981\u5206\u8bcd\uff0c\u56e0\u4e3a\u53e5\u5b50\u4e2d\u7684\u8bcd\u8bed\u4e4b\u95f4\u6ca1\u6709\u7a7a\u683c\u3002",
  "\u5bc6\u7801\u548c\u5bc6\u94a5\u4e0d\u5f97\u4fdd\u5b58\u5728\u7ef4\u57fa\u9875\u9762\u4e2d\uff0c\u5e94\u4f7f\u7528\u56e2\u961f\u7684\u5bc6\u94a5\u7ba1\u7406\u5de5\u5177\u3002",
  "\u5728\u89c6\u7a97\u7cfb\u7edf\u4e0a\u5b89\u88c5\u7a0b\u5e8f\u4e4b\u524d\uff0c\u5fc5\u987b\u5148\u68c0\u67e5\u7248\u672c\u53f7\u3002",
  "\u6bcf\u5468\u56e2\u961f\u4f1a\u8bae\u603b\u7ed3\u9879\u76ee\u8fdb\u5c55\u548c\u9047\u5230\u7684\u95ee\u9898\u3002",
  "\u4ee3\u7801\u5ba1\u67e5\u89c4\u8303\u8981\u6c42\u4e24\u540d\u5ba1\u67e5\u8005\u6279\u51c6\u540e\u624d\u80fd\u5408\u5e76\u3002",
  "\u5907\u4efd\u7cfb\u7edf\u6bcf\u665a\u8fd0\u884c\uff0c\u5e76\u4fdd\u7559\u4e03\u5929\u7684\u526f\u672c\u3002",
  "\u7528\u6237\u624b\u518c\u8bf4\u660e\u5982\u4f55\u901a\u8fc7\u4ed3\u5e93\u5730\u5740\u52a0\u5165\u56e2\u961f\u7ef4\u57fa\u3002",
  "\u6392\u67e5\u7f51\u7edc\u6545\u969c\u5e94\u5148\u68c0\u67e5\u7ebf\u7f06\u548c\u4ea4\u6362\u673a\u3002",
  "\u67b6\u6784\u51b3\u7b56\u8bb0\u5f55\u5e2e\u52a9\u56e2\u961f\u7406\u89e3\u8fc7\u53bb\u7684\u539f\u56e0\u3002",
  "\u65b0\u5458\u5de5\u57f9\u8bad\u4e3a\u671f\u4e24\u5468\uff0c\u7ed3\u4e1a\u65f6\u6709\u6d4b\u9a8c\u3002",
  "\u5ba2\u6237\u6570\u636e\u5fc5\u987b\u6309\u7167\u516c\u53f8\u7684\u9690\u79c1\u653f\u7b56\u53d7\u5230\u4fdd\u62a4\u3002"
 ],
 "en": [
  "A team knowledge base helps new members learn quickly. Every document must cite its source.",
  "Search must handle languages without spaces between words.",
  "Passwords and secret keys must never be stored in wiki pages.",
  "Check the version before installing the program on Windows.",
  "The weekly team meeting summarizes project progress and problems.",
  "Code review rules require two reviewers to approve before merging.",
  "The backup system runs every night and keeps copies for seven days.",
  "The user guide explains how to join the team wiki with a repository address.",
  "Network troubleshooting starts by checking cables and switches.",
  "Architecture decision records help the team understand past reasons.",
  "New employee training takes two weeks and ends with a quiz.",
  "Customer data must be protected under the company privacy policy."
 ]
